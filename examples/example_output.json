                  {
                    "style": {
                      "code": true
                    },
                    "text": "from slack_blocks_markdown import markdown_to_blocks",
                    "type": "text"
                  }
                ],
                "type": "rich_text_section"
              },
              {
                "elements": [
                  {
                    "text": "Convert your markdown: ",
                    "type": "text"
                  },
                  {
                    "style": {
                      "code": true
                    },
                    "text": "blocks = markdown_to_blocks(markdown_text)",
                    "type": "text"
                  }
                ],
                "type": "rich_text_section"
              },
              {
                "elements": [
                  {
                    "text": "Send to Slack API: ",
                    "type": "text"
                  },
                  {
                    "style": {
                      "code": true
                    },
                    "text": "client.chat_postMessage(channel=channel, blocks=blocks)",
                    "type": "text"
                  }
                ],
                "type": "rich_text_section"
              }
            ],
            "style": "ordered",
            "type": "rich_text_list"
